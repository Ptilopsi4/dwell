# 模型连接：选择模板，或复制到私有配置位置后修改此路径；配置文件须在代理可写工作区之外。
DWELL_MODELS_FILE=templates/models.openai-responses.json
OPENAI_API_KEY=
# 其他模板：models.openai-completions.json、models.anthropic-messages.json、
# models.zai.json、models.deepseek.json（均在 templates/ 下）。
# 模板的 apiKeyEnv 指定此处要设置的密钥变量名；JSON 中不保存密钥值。
# ANTHROPIC_API_KEY=
# LOCAL_MODEL_API_KEY=
# ZAI_CODING_CN_API_KEY=   # 同时启用网页工具，与主模型选择无关
# DEEPSEEK_API_KEY=
# 兼容旧配置：不设置 DWELL_MODELS_FILE，且 state/models.json 不存在。
# DWELL_PROVIDER=zai-coding-cn   # 或 deepseek
# DWELL_MODEL=glm-5.3
# DWELL_VISION_MODEL=glm-5.3-flash
# 可启用一个或两个机器人入口；只用 Telegram 时不需要飞书凭证。
LARK_APP_ID=
LARK_APP_SECRET=
# TELEGRAM_BOT_TOKEN=   # 从 BotFather 获取；保持群隐私模式开启
# DWELL_TELEGRAM_CHATS=-1001234567890   # 首次启动时播种逐人授权群；在群内用 /allowgroup 开放群成员
# 用户白名单：逗号分隔的飞书 open_id（ou_...）或 Telegram ID（tg:123456789）。
# 仅首次启动时写入 state/users.json；之后用 /allow 和 /disallow 管理。
DWELL_ADMINS=
DWELL_ALLOW=
# DWELL_TOOL_PATH=/usr/bin:/bin   # 收窄 bash 工具的 PATH
# DWELL_SANDBOX=required   # required | auto | off；NODE_ENV=production 时默认 required，否则默认 auto
# required 在 Linux/bwrap 探测失败时拒绝启动；auto 明确允许回退。
# Docker 镜像设置了 NODE_ENV=production，但未安装 bwrap。选择 off/auto 前先配置隔离。
# DWELL_RUN_MODEL_LIMIT=32   # 每轮普通生成请求准入数，包含持久化任务的重试
# DWELL_RUN_TOOL_LIMIT=128   # 每轮唯一工具准入数，包含被审批拦截的调用
# DWELL_RUN_TIMEOUT_MINUTES=15   # 执行阶段的实际耗时上限；不计该轮结束后的审批等待
# DWELL_TZ=Asia/Shanghai   # 定时任务与模型日期使用的时区（默认取进程时区；UTC 服务器需显式设置）
# DWELL_PANEL_PORT=7788   # 不设则不启动面板；面板没有内置登录，不要暴露到公网
# DWELL_PANEL_HOST=10.0.0.1   # 面板绑定的网络接口（不设则监听全部接口）
# DWELL_PANEL_USER=ou_xxx   # 飞书 ou_... 或 Telegram tg:<数字 ID>；默认取第一位管理员
# DWELL_PANEL_URL=https://xxx   # 面板外部访问地址；设置后任务通知附带此链接
# DWELL_PANEL_TRUST_LOCAL=1   # 仅用于同机反代或 ssh -L；开启后 bash 也能访问面板及审批接口
