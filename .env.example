# Model connection: choose a template or copy it to state/models.json and change this path.
DWELL_MODELS_FILE=templates/models.openai-responses.json
OPENAI_API_KEY=
# Other templates: models.openai-completions.json, models.anthropic-messages.json,
# models.zai.json, models.deepseek.json (all under templates/).
# Their apiKeyEnv fields name the keys to set here; the JSON never contains key values.
# ANTHROPIC_API_KEY=
# LOCAL_MODEL_API_KEY=
# ZAI_CODING_CN_API_KEY=   # also enables the web tools, regardless of the main model
# DEEPSEEK_API_KEY=
# Legacy fallback: unset DWELL_MODELS_FILE and leave state/models.json absent.
# DWELL_PROVIDER=zai-coding-cn   # or deepseek
# DWELL_MODEL=glm-5.3
# DWELL_VISION_MODEL=glm-5.3-flash
LARK_APP_ID=
LARK_APP_SECRET=
# Allowlist (comma-separated open_ids): seeds state/users.json on first start only; afterwards use /allow and /disallow
DWELL_ADMINS=
DWELL_ALLOW=
# DWELL_TOOL_PATH=/usr/bin:/bin   # narrow the PATH of the bash tool
# DWELL_SANDBOX=off   # disable the bash sandbox
# DWELL_RUN_MODEL_LIMIT=32   # normal generation request admissions per run, including durable retries
# DWELL_RUN_TOOL_LIMIT=128   # unique tool admissions per run, including approval-blocked calls
# DWELL_RUN_TIMEOUT_MINUTES=15   # execution wall time; approval waiting after the run ends is excluded
# DWELL_TZ=Asia/Shanghai   # timezone for scheduled tasks and the date given to the model (defaults to the process timezone; set explicitly on UTC servers)
# DWELL_PANEL_PORT=7788   # panel does not start when unset; it has no built-in auth, never expose it to the internet
# DWELL_PANEL_HOST=10.0.0.1   # interface the panel binds to (all interfaces when unset)
# DWELL_PANEL_USER=ou_xxx   # panel operator (defaults to the first admin); panel messages and approvals are recorded under this user
# DWELL_PANEL_URL=https://xxx   # external panel URL; task notifications link to it when set
# DWELL_PANEL_TRUST_LOCAL=1   # only for a same-host reverse proxy or ssh -L; with it on, bash can reach the panel (including approvals)
