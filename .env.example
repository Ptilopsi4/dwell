ZAI_CODING_CN_API_KEY=
# DWELL_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DWELL_MODEL=glm-5.3
# DWELL_VISION_MODEL=glm-5.3-flash   # 图片理解 subagent（主模型无视觉时用；需在 zai-coding-cn catalog 内）
LARK_APP_ID=
LARK_APP_SECRET=
# 白名单（逗号分隔 open_id）：仅首次启动播种 state/users.json，之后用 /allow /disallow 维护
DWELL_ADMINS=
DWELL_ALLOW=
# DWELL_TOOL_PATH=/usr/bin:/bin   # 收窄 bash 工具的 PATH
# DWELL_PANEL_PORT=7788   # 不设则不启动 panel；panel 无内置鉴权，勿暴露公网
# DWELL_PANEL_HOST=10.0.0.1   # panel 绑定的网络接口（缺省全部）
# DWELL_PANEL_USER=ou_xxx   # panel 操作者（缺省取第一个管理员），panel 消息/审批记在其名下
# DWELL_PANEL_URL=https://xxx   # panel 外部地址；设置后任务通知带跳转链接
# DWELL_PANEL_TRUST_LOCAL=1   # 仅同机反代/ssh -L 访问 panel 时设；开启后 bash 能直连 panel（含审批接口）
