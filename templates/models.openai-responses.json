{
  "main": {
    "name": "GPT-6 Luna",
    "api": "openai-responses",
    "baseUrl": "https://api.openai.com/v1",
    "reasoning": true,
    "input": [
      "text",
      "image"
    ],
    "cost": {
      "input": 0.1,
      "output": 0.5,
      "cacheRead": 0.01,
      "cacheWrite": 0.125,
      "tiers": [
        {
          "inputTokensAbove": 272000,
          "input": 0.2,
          "output": 0.75,
          "cacheRead": 0.02,
          "cacheWrite": 0.25
        }
      ]
    },
    "contextWindow": 272000,
    "maxTokens": 128000,
    "thinkingLevelMap": {
      "off": "none",
      "minimal": null,
      "low": "low",
      "medium": "medium",
      "high": "high",
      "xhigh": "xhigh",
      "max": "max"
    },
    "compat": {
      "supportsStrictMode": true,
      "supportsOpenAIGrammarTools": true,
      "supportsAdditionalTools": true,
      "supportsToolSearch": true,
      "supportsMidConvoSystemMessages": true,
      "supportsExplicitPromptCacheMode": true,
      "supportsMidConvoEffort": true
    },
    "inputLimits": {
      "maxRequestBytes": 536870912,
      "images": {
        "maxPerRequest": 1500,
        "resize": {
          "maxWidth": 2000,
          "maxHeight": 2000,
          "maxBytes": 4718592,
          "jpegQuality": 80
        }
      }
    },
    "model": "gpt-6-luna",
    "apiKeyEnv": "OPENAI_API_KEY"
  }
}
